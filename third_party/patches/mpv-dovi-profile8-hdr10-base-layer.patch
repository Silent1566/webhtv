diff --git a/video/decode/vd_lavc.c b/video/decode/vd_lavc.c
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -567,8 +567,29 @@
 {
     return ctx->codec && ctx->codec->dv_profile == 7 &&
            dovi_profile7_mode(vd) == DEMUX_DOVI_PROFILE7_HDR10;
+}
+
+static int dovi_profile8_mode(struct mp_filter *vd)
+{
+    struct demux_opts *opts = mp_get_config_group(vd, vd->global, &demux_conf);
+    return opts ? opts->dovi_profile8_mode : DEMUX_DOVI_PROFILE8_PRESERVE;
 }
 
+static bool dovi_profile8_hdr10_fallback(struct mp_filter *vd,
+                                         const vd_ffmpeg_ctx *ctx)
+{
+    return ctx->codec && ctx->codec->source_dv_profile == 8 &&
+           !ctx->codec->dovi &&
+           dovi_profile8_mode(vd) == DEMUX_DOVI_PROFILE8_HDR10;
+}
+
+static bool dovi_hdr10_base_layer_fallback(struct mp_filter *vd,
+                                           const vd_ffmpeg_ctx *ctx)
+{
+    return dovi_profile7_hdr10_fallback(vd, ctx)
+           || dovi_profile8_hdr10_fallback(vd, ctx);
+}
+
