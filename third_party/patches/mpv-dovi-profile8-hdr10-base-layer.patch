         ctx->vo && (ctx->vo->driver->caps & VO_CAP_NATIVE_DOVI);
     bool decoder_native_dovi_sink = native_dovi_sink &&
-                                    !dovi_profile7_hdr10_fallback(vd, ctx);
-    if (native_dovi_sink && !decoder_native_dovi_sink)
-        MP_INFO(vd, "DV7 HDR10 fallback: using MediaCodec base-layer decoder "
-                   "with direct Surface output.\n");
+                                    !dovi_hdr10_base_layer_fallback(vd, ctx);
+    if (native_dovi_sink && !decoder_native_dovi_sink) {
