diff --git a/media3ext/src/main/cpp/ffaudio.cpp b/media3ext/src/main/cpp/ffaudio.cpp
index e1aeb9e..02087d8 100644
--- a/media3ext/src/main/cpp/ffaudio.cpp
+++ b/media3ext/src/main/cpp/ffaudio.cpp
@@ -109,6 +109,27 @@ AVCodecContext *createContext(JNIEnv *env, AVCodec *codec, jbyteArray extraData,
         context->ch_layout.nb_channels = rawChannelCount;
         av_channel_layout_default(&context->ch_layout, rawChannelCount);
     }
+    if (context->codec_id == AV_CODEC_ID_APE) {
+        if (rawSampleRate <= 0 || rawChannelCount <= 0 || rawChannelCount > 2) {
+            LOGE("Invalid APE stream parameters: sampleRate=%d channels=%d.",
+                 rawSampleRate, rawChannelCount);
+            releaseContext(context);
+            return nullptr;
+        }
+        context->sample_rate = rawSampleRate;
+        context->ch_layout.nb_channels = rawChannelCount;
+        av_channel_layout_default(&context->ch_layout, rawChannelCount);
+        if (!extraData || env->GetArrayLength(extraData) < 6) {
+            LOGE("APE decoder requires six-byte extradata.");
+            releaseContext(context);
+            return nullptr;
+        }
+        jbyte flags[2];
+        env->GetByteArrayRegion(extraData, 4, 2, flags);
+        const int formatFlags = (flags[0] & 0xff) | ((flags[1] & 0xff) << 8);
+        context->bits_per_coded_sample = (formatFlags & 1) != 0
+                ? 8 : ((formatFlags & 8) != 0 ? 24 : 16);
+    }
     context->err_recognition = AV_EF_IGNORE_ERR;
     int result = avcodec_open2(context, codec, nullptr);
     if (result < 0) {
