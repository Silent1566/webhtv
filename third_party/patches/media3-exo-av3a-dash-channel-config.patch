+  @Test
+  public void parseAvs3aP7ChannelConfiguration() throws Exception {
+    DashManifestParser parser = new DashManifestParser();
+    assertThat(
+            parseAvs3aP7ChannelConfiguration(
+                parser,
+                "<AudioChannelConfiguration "
+                    + "schemeIdUri=\"urn:avs:avs3:p7:2024:audio_channel_configuration\" "
+                    + "value=\"F20101\"/>"))
+        .isEqualTo(2);
+    assertThat(
+            parseAvs3aP7ChannelConfiguration(
+                parser,
+                "<AudioChannelConfiguration "
+                    + "schemeIdUri=\"urn:avs:avs3:p7:2024:audio_channel_configuration\" "
+                    + "value=\"F20203\"/>"))
+        .isEqualTo(6);
+    assertThat(
+            parseAvs3aP7ChannelConfiguration(
+                parser,
+                "<AudioChannelConfiguration "
+                    + "schemeIdUri=\"urn:avs:avs3:p7:2024:audio_channel_configuration\" "
+                    + "value=\"F20A04\"/>"))
+        .isEqualTo(12);
+    assertThat(
+            parseAvs3aP7ChannelConfiguration(
+                parser,
+                "<AudioChannelConfiguration "
+                    + "schemeIdUri=\"urn:avs:avs3:p7:2024:audio_channel_configuration\" "
+                    + "value=\"F29999\"/>"))
+        .isEqualTo(Format.NO_VALUE);
+  }
+
+  private static int parseAvs3aP7ChannelConfiguration(DashManifestParser parser, String xml)
+      throws Exception {
+    XmlPullParser xpp = XmlPullParserFactory.newInstance().newPullParser();
+    xpp.setInput(new StringReader(xml + NEXT_TAG));
+    xpp.next();
+    return parser.parseAudioChannelConfiguration(xpp, "av3a.02");
+  }
