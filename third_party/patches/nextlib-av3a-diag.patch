+// Reuses one AVFrame per decode call instead of allocating one per output buffer.
+// Frees on every exit path, including the error returns inside the decode loop.
+struct FrameGuard {
+    AVFrame *frame;
+    explicit FrameGuard(AVFrame *value) : frame(value) {}
+    ~FrameGuard() { if (frame) av_frame_free(&frame); }
+    FrameGuard(const FrameGuard &) = delete;
+    FrameGuard &operator=(const FrameGuard &) = delete;
+};
