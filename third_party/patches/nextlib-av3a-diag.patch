+// AV3A/AVS3-P3 diagnostics: per-window decode, resample and delivery timing.
+// Prints one bounded line per window instead of per frame so playback is not perturbed.
+#include <ctime>
+namespace {
+struct DecodeStats {
+    long long sendNs = 0, recvNs = 0, swrNs = 0, packetGapNs = 0;
+    long long lastPacketNs = 0, windowStartNs = 0;
+    long frames = 0, inSamples = 0, outBytes = 0;
+    long inChannels = 0, inOrder = -1, sampleRate = 0, outChannels = 0;
+};
+DecodeStats gStats;
+inline long long nowNs() {
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<long long>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
+inline void reportDecodeStats() {
+    long long now = nowNs();
+    if (gStats.windowStartNs == 0) { gStats.windowStartNs = now; return; }
+    long long elapsed = now - gStats.windowStartNs;
+    if (elapsed < 2000000000LL) return;
+    double secs = static_cast<double>(elapsed) / 1e9;
+    double audioSecs = gStats.sampleRate > 0
+            ? static_cast<double>(gStats.inSamples) / static_cast<double>(gStats.sampleRate) : 0.0;
+    LOGD("av3a-stats win=%.2fs frames=%ld audio=%.3fs ratio=%.2f send_ms=%.1f recv_ms=%.1f "
+         "swr_ms=%.1f out_kb=%.1f in_ch=%ld in_order=%ld sr=%ld out_ch=%ld gap_ms=%.1f",
+         secs, gStats.frames, audioSecs, secs > 0 ? audioSecs / secs : 0.0,
+         gStats.sendNs / 1e6, gStats.recvNs / 1e6, gStats.swrNs / 1e6,
+         gStats.outBytes / 1024.0, gStats.inChannels, gStats.inOrder, gStats.sampleRate,
+         gStats.outChannels, gStats.packetGapNs / 1e6);
+    gStats.sendNs = gStats.recvNs = gStats.swrNs = gStats.packetGapNs = 0;
+    gStats.frames = gStats.inSamples = gStats.outBytes = 0;
+    gStats.windowStartNs = now;
+}
