<?xml version="1.0" encoding="utf-8"?>
<!--
    追更页 primary 按钮（检查更新/全部已读/导入订阅）的文本色。

    文本必须与**焦点态填充**配对：该按钮的 backgroundTint 是
    following_button_primary_bg，focused/pressed 时填充取 following_button_focus
    （= webhtv_color_focus）。2026-11-25 起 FOCUS 槽为纯白（所有焦点色默认白色，
    对齐上游 FongMi/TV 的白色焦点方案），两表的 on_primary 也都是白，
    白填充配白字只有 1.00:1——焦点/按下文本因此改取恒定深色墨色
    following_button_focus_text，对纯白填充 ≥14:1。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/following_button_focus_text" />
    <item android:state_pressed="true" android:color="@color/following_button_focus_text" />
    <item android:color="@color/webhtv_color_on_primary" />
</selector>
