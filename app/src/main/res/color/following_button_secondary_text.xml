<?xml version="1.0" encoding="utf-8"?>
<!--
    追更页 secondary 按钮（继续看/提醒开/换源/下季）的文本色。

    焦点/按下时填充会换成 following_button_focus（= webhtv_color_focus）。2026-11-25
    起 FOCUS 槽为纯白（所有焦点色默认白色），白填充配 on_primary 白字只有 1.00:1，
    所以焦点/按下文本改取恒定深色 following_button_focus_text（对纯白 ≥14:1）。
    非焦点态填充是 surface_container，文本保持 following_button_text（= primary），
    两张表下均 ≥9:1。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/following_button_focus_text" />
    <item android:state_pressed="true" android:color="@color/following_button_focus_text" />
    <item android:color="@color/following_button_text" />
</selector>
