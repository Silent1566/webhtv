<?xml version="1.0" encoding="utf-8"?>
<!--
    聚焦态填充为 FOCUS 色的控件获得焦点时的统一边框环。

    电视版焦点高亮只允许"边框环"这一种机制：这些按钮把焦点表达成填充色变化，
    聚焦时填充翻成 `webhtv_color_focus`。2026-11-25 起产品把 FOCUS 槽默认改为
    近白（所有焦点色默认白色），环色若继续配 on_primary 白环，与近白填充只剩
    1.07:1，焦点位置完全看不见；现改配恒定深色 `focus_ring_on_focus`
    （见 values/colors.xml），浅/深两表都清晰。

    擦除态用全透明而不是移除描边：MaterialButton 的 strokeWidth 是常量，
    只切换 strokeColor 的颜色值即可避免任何布局/测量变化。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/focus_ring_on_focus" android:state_focused="true" />
    <item android:color="@color/focus_ring_on_focus" android:state_pressed="true" />
    <item android:color="@android:color/transparent" />
</selector>
