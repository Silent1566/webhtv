<?xml version="1.0" encoding="utf-8"?>
<!-- 「今天」的实心底：主色承载当天，日期数字随之切成 on_primary（由适配器绑定）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/webhtv_color_primary_container" />
            <corners android:radius="@dimen/webhtv_card_radius_default" />
            <stroke android:width="@dimen/webhtv_focus_ring_width" android:color="@color/following_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/following_accent" />
            <corners android:radius="@dimen/webhtv_card_radius_default" />
        </shape>
    </item>
</selector>
